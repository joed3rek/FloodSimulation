/* Organic / Natural, for UI Toolkit. Same tokens as web/src/styles/tokens.css. */
:root {
    --background: #FDFCF8;
    --foreground: #2C2C24;
    --primary: #5D7052;
    --primary-foreground: #F3F4F1;
    --primary-soft: rgba(93, 112, 82, 0.12);
    --secondary: #C18C5D;
    --clay-ink: #8C582C;
    --accent: #E6DCCD;
    --accent-foreground: #4A4A40;
    --muted: #F0EBE5;
    --muted-foreground: #78786C;
    --border: #DED8CF;
    --destructive: #A85448;
    --card: #FEFEFA;
    --water: #4A7C96;
    -unity-font: resource("UI/Fonts/Nunito-Regular");
    color: var(--foreground);
    font-size: 14px;
}

/* the default theme sets a font definition that would override -unity-font */
* { -unity-font-definition: initial; }
Label, Button, TextField, .unity-base-text-field__input, .unity-text-element { -unity-font-definition: initial; }

/* soft scrollbars */
.unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--border); border-width: 0; border-radius: 4px; width: 6px; left: 1px; }
.unity-scroller--horizontal { display: none; }

/* ---------- layout ---------- */
.app { flex-grow: 1; flex-direction: row; }
.sidebar {
    width: 28%; min-width: 320px; max-width: 460px;
    margin: 16px 0 16px 16px;
    background-color: rgba(254, 254, 250, 0.94);
    border-width: 1px; border-color: rgba(222, 216, 207, 0.7);
    border-top-left-radius: 48px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 40px;
    padding: 18px 8px 18px 18px;
}
.brand { flex-direction: row; align-items: center; margin-bottom: 10px; }
.brand-mark {
    width: 40px; height: 40px; border-radius: 20px; background-color: var(--primary);
    align-items: center; justify-content: center; margin-right: 10px;
}
.brand-mark Label { color: var(--primary-foreground); font-size: 18px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.brand-name { font-size: 20px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.status {
    background-color: var(--primary-soft); color: var(--primary); border-radius: 16px;
    padding: 6px 12px; margin: 4px 10px 10px 0; white-space: normal; -unity-font: resource("UI/Fonts/Nunito-Bold"); font-size: 12px;
}
.status--error { background-color: rgba(168, 84, 72, 0.12); color: var(--destructive); }

/* ---------- sections ---------- */
.section { margin: 6px 10px 14px 0; }
.eyebrow { color: var(--clay-ink); font-size: 11px; letter-spacing: 2px; -unity-font: resource("UI/Fonts/Nunito-Bold"); margin-bottom: 2px; }
.h2 { font-size: 18px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); margin-bottom: 8px; }
.muted { color: var(--muted-foreground); font-size: 12px; white-space: normal; }
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }

.card {
    background-color: var(--card); border-width: 1px; border-color: rgba(222, 216, 207, 0.6);
    border-radius: 24px; border-top-left-radius: 40px; padding: 14px; margin: 4px 10px 12px 0;
}
.card--stone { background-color: rgba(240, 235, 229, 0.8); border-top-left-radius: 24px; border-bottom-right-radius: 40px; }
.card--sand { background-color: rgba(230, 220, 205, 0.55); border-top-left-radius: 24px; border-top-right-radius: 48px; }

/* ---------- controls ---------- */
.btn {
    height: 40px; padding: 0 18px; margin: 4px 6px 4px 0; border-radius: 20px; border-width: 0;
    background-color: var(--primary); color: var(--primary-foreground);
    -unity-font: resource("UI/Fonts/Nunito-Bold"); font-size: 14px;
    transition-property: scale, background-color; transition-duration: 0.3s; transition-timing-function: ease-out-cubic;
}
.btn:hover { scale: 1.04 1.04; background-color: #536548; }
.btn:active { scale: 0.96 0.96; }
.btn:disabled { opacity: 0.5; scale: 1 1; }
.btn--clay { background-color: var(--secondary); color: #FFFFFF; }
.btn--clay:hover { background-color: #B07C4E; }
.btn--outline { background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: var(--secondary); color: var(--clay-ink); }
.btn--outline:hover { background-color: rgba(193, 140, 93, 0.12); }
.btn--ghost { background-color: rgba(0, 0, 0, 0); color: var(--primary); }
.btn--ghost:hover { background-color: var(--primary-soft); }
.btn--wide { flex-grow: 1; }

.field-label { font-size: 12px; -unity-font: resource("UI/Fonts/Nunito-Bold"); color: var(--accent-foreground); margin: 6px 0 2px 12px; }
.input { margin: 0 0 4px 0; }
.input .unity-base-text-field__input, .input .unity-base-field__input {
    height: 38px; border-radius: 19px; border-width: 1px; border-color: var(--border);
    background-color: rgba(255, 255, 255, 0.6); padding: 0 14px; color: var(--foreground);
    -unity-font: resource("UI/Fonts/Nunito-Regular"); font-size: 13px;
}
.input:focus .unity-base-text-field__input { border-color: var(--primary); }
.input .unity-label { display: none; }

.chip {
    height: 34px; padding: 0 14px; margin: 3px 6px 3px 0; border-radius: 17px; border-width: 2px;
    border-color: var(--border); background-color: rgba(255, 255, 255, 0.6); color: var(--accent-foreground);
    -unity-font: resource("UI/Fonts/Nunito-Bold"); font-size: 13px;
    transition-property: background-color, border-color, scale; transition-duration: 0.3s;
}
.chip:hover { border-color: rgba(93, 112, 82, 0.5); }
.chip--on { background-color: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }

.slider { margin: 2px 0 6px 0; }
.slider .unity-label { display: none; }
.slider #unity-tracker { background-color: var(--accent); border-width: 0; height: 6px; border-radius: 3px; margin-top: -3px; }
.slider #unity-dragger { background-color: var(--primary); border-width: 0; width: 18px; height: 18px; border-radius: 9px; margin-top: -9px; }

.textarea .unity-base-text-field__input {
    min-height: 140px; border-radius: 18px; border-width: 1px; border-color: var(--border);
    background-color: rgba(255, 255, 255, 0.6); padding: 10px; -unity-font: resource("UI/Fonts/Nunito-Regular"); font-size: 11px;
    white-space: normal;
}

/* ---------- results ---------- */
.result-row { flex-direction: row; justify-content: space-between; padding: 5px 2px; border-bottom-width: 1px; border-color: rgba(222, 216, 207, 0.6); }
.result-row Label { font-size: 12px; }
.strong { -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.stat-value { font-size: 26px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.notice {
    background-color: rgba(93, 112, 82, 0.08); border-width: 1px; border-color: rgba(93, 112, 82, 0.2);
    border-radius: 18px; border-top-left-radius: 6px; padding: 10px 12px; margin: 6px 0; white-space: normal; font-size: 12px;
}
.notice--warn { background-color: rgba(193, 140, 93, 0.12); border-color: rgba(193, 140, 93, 0.35); }

/* ---------- overlays on the views ---------- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.pill {
    position: absolute; background-color: rgba(255, 255, 255, 0.8); border-radius: 22px; padding: 8px 18px;
    flex-direction: row; align-items: center; border-width: 1px; border-color: rgba(222, 216, 207, 0.6);
}
.pill-title { font-size: 18px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); margin-right: 10px; }
.pill-text { font-size: 13px; color: var(--accent-foreground); }
.litres {
    position: absolute; background-color: rgba(255, 255, 255, 0.82); padding: 10px 18px;
    border-radius: 20px; border-top-right-radius: 36px; border-width: 1px; border-color: rgba(222, 216, 207, 0.6);
}
.litres-label { font-size: 11px; letter-spacing: 1.5px; color: var(--muted-foreground); -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.litres-value { font-size: 30px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.litres-unit { font-size: 13px; color: var(--muted-foreground); margin-left: 6px; margin-bottom: 6px; -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.footnote { position: absolute; bottom: 8px; font-size: 11px; color: var(--muted-foreground); }
.grain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0.05; }
.blob { position: absolute; }

/* ================= landing (dark) ================= */
.landing {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #1B1C16; overflow: hidden;
    align-items: center;
}
.contour-art { position: absolute; left: -8%; top: -14%; width: 760px; height: 760px; }
.rain-art { position: absolute; right: -4%; bottom: -6%; width: 640px; height: 460px; }
.landing-nav { position: absolute; left: 0; right: 0; top: 0; padding: 30px 90px; align-items: center; }
.landing-brand { color: var(--primary-foreground); font-size: 26px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.engine-chip {
    color: var(--primary-foreground); background-color: rgba(93, 112, 82, 0.45); border-radius: 16px;
    padding: 6px 14px; margin-right: 10px; font-size: 12px; -unity-font: resource("UI/Fonts/Nunito-Bold");
}
.engine-chip--off { background-color: rgba(168, 84, 72, 0.55); }
.btn--light { background-color: var(--primary-foreground); color: #1B1C16; }
.btn--light:hover { background-color: #FFFFFF; }
.hero { margin-top: 140px; width: 760px; align-items: center; }
.hero-title {
    color: var(--primary-foreground); font-size: 64px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold");
    -unity-text-align: middle-center; margin: 0;
}
.hero-accent { color: var(--accent); }
.hero-text {
    color: rgba(243, 244, 241, 0.78); font-size: 17px; white-space: normal; -unity-text-align: middle-center;
    margin: 18px 40px 36px 40px;
}
.drop {
    width: 560px; padding: 34px 20px; border-width: 1px; border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.05); border-radius: 40px; border-top-left-radius: 72px;
    align-items: center; transition-property: background-color, scale, border-color; transition-duration: 0.5s;
}
.drop:hover { background-color: rgba(255, 255, 255, 0.11); border-color: rgba(230, 220, 205, 0.7); scale: 1.02 1.02; }
.drop-icon { width: 64px; height: 64px; border-radius: 32px; background-color: var(--primary); align-items: center; justify-content: center; margin-bottom: 12px; }
.drop-arrow { color: var(--primary-foreground); font-size: 28px; -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.drop-title { color: var(--primary-foreground); font-size: 26px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); }
.drop-text { color: rgba(243, 244, 241, 0.6); font-size: 13px; margin-top: 2px; }
.hero-small { color: rgba(243, 244, 241, 0.5); font-size: 11px; letter-spacing: 3px; margin: 28px 0 8px 0; -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.path-row { width: 560px; flex-wrap: nowrap; }
.path-input { flex-grow: 1; margin-right: 8px; }
.hero-status { color: var(--accent); font-size: 13px; margin-top: 10px; white-space: normal; -unity-text-align: middle-center; }
.recent-row { justify-content: center; }
.btn--recent { background-color: rgba(255, 255, 255, 0.06); border-width: 1px; border-color: rgba(255, 255, 255, 0.15); color: var(--primary-foreground); }
.btn--recent:hover { background-color: rgba(193, 140, 93, 0.35); }
.wordmark {
    position: absolute; left: 60px; bottom: -30px; font-size: 150px; color: rgba(255, 255, 255, 0.06);
    -unity-font: resource("UI/Fonts/Fraunces-SemiBold");
}

/* file browser */
.modal-back { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(27, 28, 22, 0.55); align-items: center; justify-content: center; }
.modal {
    width: 640px; height: 70%; background-color: var(--card); border-radius: 32px; border-top-left-radius: 64px;
    padding: 26px; border-width: 1px; border-color: rgba(222, 216, 207, 0.6);
}
.modal-list { flex-grow: 1; margin: 10px 0; }
.file-item {
    -unity-text-align: middle-left; height: 40px; border-width: 0; border-radius: 16px; background-color: rgba(0, 0, 0, 0);
    color: var(--accent-foreground); padding-left: 14px; margin: 1px 0; font-size: 14px;
}
.file-item:hover { background-color: rgba(230, 220, 205, 0.6); }
.file-item--file { color: var(--primary); -unity-font: resource("UI/Fonts/Nunito-Bold"); }

/* ================= intake (light) ================= */
.intake { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--background); }
/* the plan fills the screen; the questions panel floats over its left side and slides away */
.plan { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--background); }
.intake-panel {
    position: absolute; left: 16px; top: 16px; bottom: 16px; width: 484px;
    background-color: rgba(254, 254, 250, 0.96); border-width: 1px; border-color: rgba(222, 216, 207, 0.8);
    border-radius: 32px; border-bottom-left-radius: 64px;
    transition-property: translate, opacity; transition-duration: 0.25s, 0.25s; transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.intake-panel--closed { translate: -110% 0; opacity: 0; }
.intake-scroll { flex-grow: 1; padding: 22px 26px 22px 30px; }
.panel-top { justify-content: space-between; }
.plan-caption {
    position: absolute; top: 22px; right: 24px; padding: 8px 16px; border-radius: 18px;
    background-color: rgba(254, 254, 250, 0.92); border-width: 1px; border-color: var(--border);
    color: var(--accent-foreground); font-size: 13px; -unity-font: resource("UI/Fonts/Nunito-Bold");
}
.plan-tools { position: absolute; right: 24px; bottom: 24px; align-items: flex-end; }
.btn.plan-btn {
    width: 46px; height: 46px; min-width: 46px; margin: 8px 0 0 0; padding: 0; border-radius: 23px;
    background-color: var(--card); border-width: 1px; border-color: var(--border); color: var(--foreground);
    font-size: 22px; -unity-text-align: middle-center;
}
.btn.plan-btn:hover { background-color: var(--accent); }
.btn.plan-btn--fit { width: auto; padding: 0 18px; font-size: 13px; -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.plan-hint { position: absolute; right: 96px; bottom: 36px; color: var(--muted-foreground); font-size: 12px; }
.btn.plan-open { position: absolute; left: 24px; top: 22px; }
.q-card-head { align-items: flex-start; }
.btn.btn--show { height: 30px; padding: 0 12px; font-size: 12px; margin-left: 8px; flex-shrink: 0; }
.page-title { font-size: 40px; -unity-font: resource("UI/Fonts/Fraunces-SemiBold"); white-space: normal; margin: 2px 0 8px 0; }
.lead { font-size: 15px; color: var(--muted-foreground); white-space: normal; margin-bottom: 26px; }
.q-head { justify-content: space-between; align-items: center; margin-top: 4px; }
.badge {
    background-color: rgba(193, 140, 93, 0.15); color: var(--clay-ink); border-radius: 12px; padding: 4px 12px;
    font-size: 12px; -unity-font: resource("UI/Fonts/Nunito-Bold");
}
.q-grid { align-items: flex-start; margin-bottom: 24px; }
.q-card { padding: 16px; margin-bottom: 12px; }
.card--alt { border-top-left-radius: 24px; border-bottom-right-radius: 48px; }
.q-card--done { border-color: var(--primary); border-width: 2px; }
.q-image {
    height: 230px; background-color: var(--background); border-radius: 22px; border-top-left-radius: 44px;
    border-width: 4px; border-color: #FFFFFF; margin-bottom: 12px;
}
.mono { font-size: 15px; -unity-font: resource("UI/Fonts/Nunito-Bold"); }
.q-ask { font-size: 14px; -unity-font: resource("UI/Fonts/Nunito-Bold"); white-space: normal; margin: 10px 0 6px 0; }
.link-list {
    background-color: rgba(255, 255, 255, 0.55); border-width: 1px; border-color: rgba(222, 216, 207, 0.7);
    border-radius: 28px; border-top-right-radius: 56px; margin: 10px 10px 30px 0; padding: 6px 0;
}
.link-row { flex-direction: row; align-items: center; padding: 6px 16px; border-bottom-width: 1px; border-color: rgba(222, 216, 207, 0.5); }
.link-row:hover { background-color: rgba(230, 220, 205, 0.35); }
.link-dropdown { width: 190px; flex-shrink: 0; }
.input .unity-base-popup-field__input, .input .unity-popup-field__input {
    height: 34px; border-radius: 17px; border-width: 1px; border-color: var(--border); background-color: rgba(255, 255, 255, 0.7);
    padding: 0 14px; color: var(--foreground); font-size: 13px;
}
.figure {
    flex-grow: 1; max-height: 60%; background-color: var(--background); border-radius: 32px; border-bottom-left-radius: 64px;
    border-width: 4px; border-color: #FFFFFF; overflow: hidden; margin-top: 50px;
}
.figure-image { flex-grow: 1; }
.caption { -unity-text-align: middle-center; margin: 8px 0 14px 0; }

/* fixes: text fields keep their full height; dark-background field; back link */
.input { min-height: 40px; margin-bottom: 6px; }
.path-input .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.25); color: var(--primary-foreground);
}
.btn--back { align-self: flex-start; padding-left: 0; }
/* the field itself carries the height; its inner box fills it */
TextField.input, DropdownField.input { height: 40px; min-height: 40px; margin: 0 0 8px 0; }
.input .unity-base-text-field__input, .input .unity-base-popup-field__input { height: auto; flex-grow: 1; }
/* cards and controls keep their size; the drawing preview is what gives way */
.card, TextField.input, DropdownField.input, .btn, .chip, .field-label { flex-shrink: 0; }
.figure { flex-shrink: 1; min-height: 200px; }
/* landing: two ways in */
.choice-row { justify-content: center; flex-wrap: nowrap; }
.drop--new, .drop--open { width: 330px; margin: 0 10px; padding: 26px 16px; }
.drop--open { border-top-left-radius: 40px; border-top-right-radius: 72px; }
.drop-icon--clay { background-color: var(--secondary); }
