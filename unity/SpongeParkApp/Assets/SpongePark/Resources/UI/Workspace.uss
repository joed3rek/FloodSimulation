/* Sponge Park workspace: dark, token-based theme for UI Toolkit (replaces Organic.uss).
   Contrast (WCAG): primary text 10.3-14.8:1, secondary 5.6-8.0:1, accent 4.5-6.5:1 on every background level. */
:root {
    /* backgrounds, from the window to things floating over the view */
    --bg-app: #16181B;
    --bg-panel: #1E2125;
    --bg-raised: #272B30;
    --bg-overlay: #30353B;
    --bg-hover: #353B42;
    /* text */
    --text-primary: #E8EAED;
    --text-secondary: #A9AFB7;
    --text-disabled: #6B7178;
    /* one accent: primary actions, selection, focus */
    --accent: #4FA3E0;
    --accent-ink: #0E1A24;
    --accent-soft: rgba(79, 163, 224, 0.16);
    --success: #5DBB7A;
    --warning: #E3B341;
    --danger: #F58A80;
    --border: #33383E;
    --border-strong: #474D55;
    --focus: #8CC4EC;
    --plan-bg: #1A1D21;

    -unity-font: resource("UI/Fonts/Inter-Regular");
    color: var(--text-primary);
    font-size: 12px;
}

/* the default theme sets a font definition that would override -unity-font */
* { -unity-font-definition: initial; }
Label, Button, TextField, .unity-base-text-field__input, .unity-text-element { -unity-font-definition: initial; }

.unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--border-strong); border-width: 0; border-radius: 4px; width: 6px; left: 1px; }
.unity-scroller--horizontal { display: none; }

/* ================= workspace shell ================= */
.ws { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: column; }
.icon { width: 16px; height: 16px; flex-shrink: 0; -unity-background-image-tint-color: var(--text-secondary); }
.icon--lg { width: 22px; height: 22px; }

/* app bar */
.appbar {
    height: 32px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 6px;
    background-color: var(--bg-app); border-bottom-width: 1px; border-color: var(--border);
}
.appbar-logo { flex-direction: row; align-items: center; height: 26px; padding: 0 8px 0 4px; border-width: 0; border-radius: 4px; background-color: rgba(0, 0, 0, 0); margin: 0 4px 0 0; }
.appbar-logo:hover:enabled { background-color: var(--bg-hover); }
.logo-mark { width: 18px; height: 18px; border-radius: 4px; background-color: var(--accent); margin-right: 8px; align-items: center; justify-content: center; }
.logo-mark Label { color: var(--accent-ink); font-size: 11px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); margin: 0; padding: 0; }
.appbar-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 12px; margin: 0; }
.appbar-sep { width: 1px; height: 16px; background-color: var(--border-strong); margin: 0 10px; }
.appbar-project { font-size: 12px; color: var(--text-primary); margin: 0; -unity-font: resource("UI/Fonts/Inter-Medium"); }
.appbar-saved { font-size: 11px; color: var(--text-secondary); margin: 0 0 0 8px; }
.appbar-gap { flex-grow: 1; }
.search {
    width: 280px; height: 22px; flex-direction: row; align-items: center; padding: 0 8px; margin: 0 12px;
    border-radius: 4px; border-width: 1px; border-color: var(--border); background-color: var(--bg-panel);
}
.search Label { color: var(--text-disabled); font-size: 11px; margin: 0 0 0 6px; flex-grow: 1; }
.search .kbd { color: var(--text-disabled); }
.seg { flex-direction: row; border-width: 1px; border-color: var(--border); border-radius: 4px; overflow: hidden; margin: 0 6px; }
.seg-btn {
    height: 22px; padding: 0 10px; margin: 0; border-width: 0; border-radius: 0; background-color: var(--bg-panel);
    color: var(--text-secondary); font-size: 11px; -unity-font: resource("UI/Fonts/Inter-Medium");
}
.seg-btn:hover:enabled { background-color: var(--bg-hover); color: var(--text-primary); }
.seg-btn--on { background-color: var(--accent-soft); color: var(--accent); }
.seg-btn--on:hover:enabled { background-color: var(--accent-soft); color: var(--accent); }

/* small icon buttons (app bar, panel heads, overlays) */
.ib {
    width: 26px; height: 26px; margin: 0 1px; padding: 0; border-width: 0; border-radius: 4px;
    background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center;
}
.ib:hover:enabled { background-color: var(--bg-hover); }
.ib:hover:enabled .icon { -unity-background-image-tint-color: var(--text-primary); }
.ib:disabled .icon { -unity-background-image-tint-color: var(--text-disabled); }
.ib--on { background-color: var(--accent-soft); }
.ib--on .icon { -unity-background-image-tint-color: var(--accent); }

/* ribbon */
.ribbon { flex-shrink: 0; background-color: var(--bg-panel); border-bottom-width: 1px; border-color: var(--border); }
.ribbon-tabs { flex-direction: row; align-items: flex-end; height: 28px; padding: 0 8px; }
.ribbon-tab {
    height: 28px; padding: 0 14px; margin: 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary); font-size: 12px; -unity-font: resource("UI/Fonts/Inter-Medium");
    border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0);
}
.ribbon-tab:hover:enabled { color: var(--text-primary); background-color: rgba(0, 0, 0, 0); }
.ribbon-tab--on { color: var(--text-primary); border-color: var(--accent); }
.ribbon-body { flex-direction: row; height: 82px; padding: 4px 6px 0 6px; overflow: hidden; }
.ribbon--collapsed .ribbon-body { display: none; }
.ribbon-group { flex-direction: column; padding: 0 6px; border-right-width: 1px; border-color: var(--border); flex-shrink: 0; }
.ribbon-buttons { flex-direction: row; align-items: flex-start; flex-grow: 1; }
.ribbon-stack { flex-direction: column; }
.ribbon-group-title { color: var(--text-secondary); font-size: 10px; -unity-text-align: middle-center; margin: 0; padding: 2px 0 4px 0; }
.rb {
    margin: 0 1px; padding: 0; border-width: 0; border-radius: 4px; background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary); font-size: 11px; align-items: center;
}
.rb:hover:enabled { background-color: var(--bg-hover); }
.rb:disabled { color: var(--text-disabled); }
.rb:disabled .icon { -unity-background-image-tint-color: var(--text-disabled); }
.rb--large { width: 64px; height: 58px; flex-direction: column; justify-content: center; }
.rb--large .rb-label { white-space: normal; -unity-text-align: upper-center; margin: 4px 2px 0 2px; font-size: 11px; }
.rb--small { height: 19px; flex-direction: row; padding: 0 6px 0 4px; }
.rb--small .rb-label { margin: 0 0 0 5px; font-size: 11px; }
.rb-label { padding: 0; color: var(--text-primary); }
.rb:disabled .rb-label { color: var(--text-disabled); }
.rb--on { background-color: var(--accent-soft); }
.rb--on .icon { -unity-background-image-tint-color: var(--accent); }
.rb--on .rb-label { color: var(--accent); }
.rb--primary .icon { -unity-background-image-tint-color: var(--accent); }
.ribbon-field { width: 170px; margin: 2px 2px; }

/* middle row: contents | viewport | properties */
.ws-middle { flex-grow: 1; flex-direction: row; min-height: 0; }
.panel { background-color: var(--bg-panel); flex-shrink: 0; flex-direction: column; overflow: hidden; }
.panel--left { border-right-width: 1px; border-color: var(--border); }
.panel--right { border-left-width: 1px; border-color: var(--border); }
.panel-head {
    height: 28px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 4px 0 10px;
    border-bottom-width: 1px; border-color: var(--border); background-color: var(--bg-panel);
}
.panel-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 11px; letter-spacing: 1px; color: var(--text-secondary); margin: 0; flex-grow: 1; }
.panel-body { flex-grow: 1; }
.panel--collapsed { width: 36px; }
.panel--collapsed .panel-body, .panel--collapsed .panel-title, .panel--collapsed .props-tabs { display: none; }
.panel--collapsed .panel-head { padding: 0; justify-content: center; }
.strip { flex-direction: column; align-items: center; padding-top: 6px; display: none; }
.panel--collapsed .strip { display: flex; }
.splitter { width: 4px; flex-shrink: 0; background-color: var(--bg-app); }
.splitter:hover { background-color: var(--accent-soft); }
.right-col { flex-direction: column; flex-shrink: 0; }

.centre { flex-grow: 1; flex-direction: column; min-width: 0; }
.viewport { flex-grow: 1; overflow: hidden; }
.vp-tl, .vp-tr, .vp-bl, .vp-br, .vp-tc { position: absolute; flex-direction: row; align-items: center; }
.vp-tl { left: 10px; top: 10px; }
.vp-tr { right: 10px; top: 10px; }
.vp-bl { left: 10px; bottom: 10px; align-items: flex-end; }
.vp-br { right: 10px; bottom: 10px; align-items: flex-end; }
.vp-tc { top: 10px; left: 30%; right: 30%; justify-content: center; }
.vp-box {
    flex-direction: row; align-items: center; padding: 2px; margin: 0 6px 0 0;
    background-color: rgba(30, 33, 37, 0.92); border-width: 1px; border-color: var(--border); border-radius: 6px;
}
.vp-hint {
    padding: 4px 10px; background-color: rgba(30, 33, 37, 0.92); border-width: 1px; border-color: var(--border);
    border-radius: 6px; color: var(--text-primary); font-size: 11px; white-space: normal; -unity-text-align: middle-center;
}
.north { width: 30px; height: 30px; border-radius: 15px; align-items: center; justify-content: center; }
.north Label { font-size: 9px; color: var(--text-secondary); margin: 0; padding: 0; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.scalebar { flex-direction: column; padding: 4px 8px; background-color: rgba(30, 33, 37, 0.85); border-radius: 4px; }
.scalebar-bar { height: 4px; border-width: 1px; border-top-width: 0; border-color: var(--text-primary); }
.scalebar Label { font-size: 10px; color: var(--text-primary); margin: 2px 0 0 0; padding: 0; }
.legend { padding: 6px 8px; background-color: rgba(30, 33, 37, 0.92); border-width: 1px; border-color: var(--border); border-radius: 6px; min-width: 140px; }
.legend-title { font-size: 10px; color: var(--text-secondary); margin: 0 0 4px 0; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.legend-ramp { height: 8px; border-radius: 2px; margin-bottom: 2px; }
.legend-ends { flex-direction: row; justify-content: space-between; }
.legend-ends Label { font-size: 10px; color: var(--text-secondary); margin: 0; padding: 0; }
.cube { flex-direction: column; align-items: center; }
.cube-row { flex-direction: row; }
.cube-btn {
    width: 22px; height: 18px; margin: 1px; padding: 0; border-width: 0; border-radius: 3px; background-color: var(--bg-raised);
    color: var(--text-secondary); font-size: 9px; -unity-font: resource("UI/Fonts/Inter-SemiBold");
}
.cube-btn:hover:enabled { background-color: var(--bg-hover); color: var(--text-primary); }
.cube-btn--top { width: 34px; }

/* contents tree */
.tree-tools { flex-direction: row; justify-content: flex-end; padding: 2px 4px; border-bottom-width: 1px; border-color: var(--border); }
.tree-group-head { flex-direction: row; align-items: center; height: 24px; padding: 0 6px; margin-top: 4px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); }
.tree-group-head:hover:enabled { background-color: var(--bg-hover); }
.tree-group-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 11px; color: var(--text-secondary); margin: 0 0 0 4px; flex-grow: 1; letter-spacing: 0.5px; -unity-text-align: middle-left; }
.tree-group-count { font-size: 10px; color: var(--text-disabled); margin: 0 4px 0 0; }
.tree-row {
    flex-direction: row; align-items: center; height: 24px; padding: 0 6px 0 18px; margin: 0;
    border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
}
.tree-row:hover:enabled { background-color: var(--bg-hover); }
.tree-row--sel { background-color: var(--accent-soft); }
.tree-row--sel:hover:enabled { background-color: var(--accent-soft); }
.tree-row--off .tree-label, .tree-row--off .tree-count { color: var(--text-disabled); }
.tree-row--off .tree-swatch { opacity: 0.3; }
.tree-row--check .tree-count { color: var(--warning); }
.tree-eye { width: 20px; height: 20px; margin: 0 4px 0 0; padding: 0; border-width: 0; border-radius: 3px; background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.tree-eye:hover:enabled { background-color: var(--bg-overlay); }
.tree-swatch { width: 10px; height: 10px; border-radius: 2px; margin-right: 8px; flex-shrink: 0; }
.tree-label { font-size: 12px; color: var(--text-primary); margin: 0; padding: 0; flex-grow: 1; -unity-text-align: middle-left; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tree-count { font-size: 11px; color: var(--text-secondary); margin: 0 0 0 6px; flex-shrink: 0; }
.tree-lock { width: 12px; height: 12px; margin-left: 4px; }
.empty { color: var(--text-secondary); font-size: 11px; white-space: normal; padding: 10px 12px; }

/* properties */
.props-tabs { flex-direction: row; height: 28px; flex-shrink: 0; border-bottom-width: 1px; border-color: var(--border); padding-left: 4px; }
.props-tab {
    height: 28px; padding: 0 10px; margin: 0; border-width: 0; border-radius: 0; border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0); color: var(--text-secondary); font-size: 11px; -unity-font: resource("UI/Fonts/Inter-Medium");
}
.props-tab:hover:enabled { color: var(--text-primary); background-color: rgba(0, 0, 0, 0); }
.props-tab--on { color: var(--text-primary); border-color: var(--accent); }
.props-scroll { flex-grow: 1; }
.props-section { padding: 8px 10px 10px 10px; border-bottom-width: 1px; border-color: var(--border); }
.props-section-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 11px; color: var(--text-secondary); margin: 0 0 6px 0; letter-spacing: 0.5px; }

/* checklist */
.checklist { border-bottom-width: 1px; border-color: var(--border-strong); flex-shrink: 0; }
.check-item { flex-direction: row; align-items: flex-start; padding: 6px 10px; border-left-width: 2px; border-color: rgba(0, 0, 0, 0); }
.check-item--current { border-color: var(--accent); background-color: var(--accent-soft); }
.check-mark { width: 16px; height: 16px; margin: 1px 8px 0 0; }
.check-item--done .check-mark { -unity-background-image-tint-color: var(--success); }
.check-item--current .check-mark { -unity-background-image-tint-color: var(--accent); }
.check-words { flex-grow: 1; flex-shrink: 1; }
.check-title { font-size: 12px; margin: 0; -unity-font: resource("UI/Fonts/Inter-Medium"); white-space: normal; }
.check-item--done .check-title { color: var(--text-secondary); }
.check-item--locked .check-title { color: var(--text-disabled); }
.check-why { font-size: 11px; color: var(--text-secondary); margin: 2px 0 0 0; white-space: normal; }
.check-item--locked .check-why { color: var(--text-disabled); }
.check-go { margin: 4px 0 0 0; align-self: flex-start; }

/* timeline */
.timeline { flex-shrink: 0; background-color: var(--bg-panel); border-top-width: 1px; border-color: var(--border); }
.timeline-head { flex-direction: row; align-items: center; height: 26px; padding: 0 6px; }
.timeline-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 11px; color: var(--text-primary); margin: 0 10px 0 4px; }
.timeline-text { font-size: 11px; color: var(--text-secondary); margin: 0; flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.timeline-body { flex-direction: row; align-items: center; height: 62px; padding: 0 10px 6px 6px; }
.timeline--collapsed .timeline-body { display: none; }
.timeline-controls { flex-direction: row; align-items: center; flex-shrink: 0; }
.speed { width: 110px; flex-shrink: 0; margin-left: 4px; }
.speed Label { font-size: 10px; color: var(--text-secondary); margin: 0; }
.hyeto-wrap { flex-grow: 1; flex-direction: column; margin: 0 12px; min-width: 120px; }
.hyeto { flex-grow: 1; flex-direction: row; align-items: flex-end; min-height: 30px; border-bottom-width: 1px; border-color: var(--border-strong); }
.hyeto-bar { flex-grow: 1; margin: 0 1px; background-color: rgba(79, 163, 224, 0.45); border-top-left-radius: 1px; border-top-right-radius: 1px; }
.hyeto-bar--past { background-color: var(--accent); }
.hyeto-empty { color: var(--text-secondary); font-size: 11px; -unity-text-align: middle-center; flex-grow: 1; align-self: center; }
.scrub { margin: 0; height: 14px; }
.scrub .unity-label { display: none; }
.scrub #unity-tracker { background-color: var(--bg-raised); border-width: 0; height: 4px; margin-top: -2px; border-radius: 2px; }
.scrub #unity-dragger { background-color: var(--accent); border-width: 0; width: 10px; height: 12px; margin-top: -6px; border-radius: 2px; }
.timeline-side { flex-direction: column; flex-shrink: 0; width: 230px; }
.kept { flex-direction: row; align-items: center; margin-top: 4px; }
.kept Label { margin: 0 6px 0 0; font-size: 11px; color: var(--text-secondary); }
.kept .kept-value { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 13px; color: var(--text-primary); }
.foot { font-size: 10px; color: var(--text-disabled); margin: 2px 0 0 0; }

/* status bar */
.statusbar {
    height: 24px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 4px;
    background-color: var(--bg-app); border-top-width: 1px; border-color: var(--border);
}
.sb { font-size: 11px; color: var(--text-secondary); margin: 0; padding: 0 8px; border-right-width: 1px; border-color: var(--border); -unity-text-align: middle-left; }
.sb--value { color: var(--text-primary); }
.sb--grow { flex-grow: 1; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-right-width: 0; }
.sb--error { color: var(--danger); }
.sb-dot { width: 7px; height: 7px; border-radius: 4px; background-color: var(--text-disabled); margin: 0 4px 0 8px; }
.sb-dot--ok { background-color: var(--success); }
.sb-dot--busy { background-color: var(--warning); }
.sb-btn { height: 18px; padding: 0 6px; margin: 0 2px; border-width: 0; border-radius: 3px; background-color: rgba(0, 0, 0, 0); color: var(--text-secondary); font-size: 11px; flex-direction: row; align-items: center; }
.sb-btn:hover:enabled { background-color: var(--bg-hover); }
.sb-btn--on { color: var(--accent); }
.sb-budget { width: 60px; height: 6px; border-radius: 3px; background-color: var(--bg-raised); margin: 0 6px; overflow: hidden; }
.sb-budget-fill { height: 6px; background-color: var(--accent); width: 0; }
.sb-budget-fill--over { background-color: var(--danger); }

/* toasts */
.toasts { position: absolute; right: 12px; bottom: 34px; width: 320px; flex-direction: column-reverse; }
.toast {
    flex-direction: row; align-items: flex-start; padding: 8px 10px; margin-top: 6px; border-radius: 6px;
    background-color: var(--bg-overlay); border-width: 1px; border-color: var(--border-strong); border-left-width: 3px;
    transition-property: opacity, translate; transition-duration: 0.25s;
}
.toast Label { white-space: normal; flex-shrink: 1; flex-grow: 1; margin: 0 0 0 8px; font-size: 12px; }
.toast--ok { border-left-color: var(--success); }
.toast--error { border-left-color: var(--danger); }
.toast--info { border-left-color: var(--accent); }
.toast--hidden { opacity: 0; translate: 0 10px; }

/* dialogs */
.dialog-back { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 11, 13, 0.6); align-items: center; justify-content: center; }
.dialog {
    width: 560px; max-height: 88%; background-color: var(--bg-panel); border-width: 1px; border-color: var(--border-strong);
    border-radius: 8px; overflow: hidden;
}
.dialog-head { flex-direction: row; align-items: center; height: 36px; padding: 0 6px 0 14px; border-bottom-width: 1px; border-color: var(--border); flex-shrink: 0; }
.dialog-title { -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 14px; flex-grow: 1; margin: 0; }
.dialog-tabs { flex-direction: row; padding-left: 8px; border-bottom-width: 1px; border-color: var(--border); flex-shrink: 0; }
.dialog-body { flex-grow: 1; padding: 6px 14px 14px 14px; }
.dialog-foot { flex-direction: row; justify-content: flex-end; padding: 8px 12px; border-top-width: 1px; border-color: var(--border); flex-shrink: 0; }

/* ================= controls (shared by panels, dialogs, start screen, intake) ================= */
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.eyebrow { color: var(--text-secondary); font-size: 10px; letter-spacing: 1.5px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); margin: 6px 0 4px 0; }
.h2 { font-size: 14px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); margin-bottom: 6px; }
.muted { color: var(--text-secondary); font-size: 12px; white-space: normal; }
.strong { -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.section { margin: 4px 0 10px 0; }
.card { background-color: var(--bg-raised); border-width: 1px; border-color: var(--border); border-radius: 6px; padding: 10px; margin: 4px 0 10px 0; }
.card--stone, .card--sand { background-color: var(--bg-raised); }

.btn {
    height: 28px; padding: 0 12px; margin: 4px 6px 4px 0; border-radius: 4px; border-width: 0;
    background-color: var(--accent); color: var(--accent-ink); -unity-font: resource("UI/Fonts/Inter-SemiBold"); font-size: 12px;
    transition-property: background-color; transition-duration: 0.15s;
}
.btn:hover:enabled { background-color: #6BB3E8; }
.btn:disabled { opacity: 0.45; }
.btn--clay { background-color: var(--accent); color: var(--accent-ink); }
.btn--outline { background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: var(--border-strong); color: var(--text-primary); }
.btn--outline:hover:enabled { background-color: var(--bg-hover); }
.btn--ghost { background-color: rgba(0, 0, 0, 0); color: var(--accent); }
.btn--ghost:hover:enabled { background-color: var(--accent-soft); }
.btn--wide { flex-grow: 1; }
.btn--link { height: 24px; padding: 0 8px; margin: 0; background-color: rgba(0, 0, 0, 0); color: var(--text-secondary); font-size: 11px; }
.btn--link:hover:enabled { background-color: var(--bg-hover); color: var(--text-primary); }

.field-label { font-size: 11px; -unity-font: resource("UI/Fonts/Inter-Medium"); color: var(--text-secondary); margin: 6px 0 2px 0; }
.input { margin: 0 0 6px 0; min-height: 28px; }
TextField.input, DropdownField.input { height: 28px; min-height: 28px; margin: 0 0 6px 0; }
.input .unity-base-text-field__input, .input .unity-base-field__input, .input .unity-base-popup-field__input, .input .unity-popup-field__input {
    border-radius: 4px; border-width: 1px; border-color: var(--border-strong); background-color: var(--bg-app);
    padding: 0 8px; color: var(--text-primary); -unity-font: resource("UI/Fonts/Inter-Regular"); font-size: 12px; height: auto; flex-grow: 1;
}
.input:focus .unity-base-text-field__input { border-color: var(--focus); }
.input .unity-label { display: none; }
.field-stack { flex-direction: column; height: auto; min-height: 52px; }
.field-stack > Label { display: flex; margin-bottom: 4px; -unity-font: resource("UI/Fonts/Inter-Medium"); font-size: 11px; color: var(--text-secondary); }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--text-secondary); }

.chip {
    height: 24px; padding: 0 10px; margin: 2px 4px 2px 0; border-radius: 4px; border-width: 1px;
    border-color: var(--border-strong); background-color: var(--bg-raised); color: var(--text-primary);
    -unity-font: resource("UI/Fonts/Inter-Medium"); font-size: 11px;
}
.chip:hover:enabled { background-color: var(--bg-hover); }
.chip--on { background-color: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
.chip--on:hover:enabled { background-color: var(--accent-soft); }

.slider { margin: 2px 0 6px 0; }
.slider .unity-label { display: none; }
.slider #unity-tracker { background-color: var(--bg-overlay); border-width: 0; height: 4px; border-radius: 2px; margin-top: -2px; }
.slider #unity-dragger { background-color: var(--accent); border-width: 0; width: 12px; height: 12px; border-radius: 6px; margin-top: -6px; }
Toggle Label { color: var(--text-primary); font-size: 12px; }

/* results, notices, checks */
.result-row { flex-direction: row; align-items: center; flex-wrap: nowrap; margin: 3px 0; padding: 0; border-bottom-width: 0; justify-content: flex-start; }
.result-row Label { font-size: 11px; }
.result-rp { width: 56px; font-size: 11px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); flex-shrink: 0; }
.result-bar { flex-grow: 1; height: 8px; border-radius: 2px; background-color: var(--bg-overlay); margin: 0 6px; overflow: hidden; }
.result-bar-after { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--accent); }
.result-bar-before { position: absolute; left: 0; top: 2px; bottom: 2px; background-color: rgba(232, 234, 237, 0.4); }
.result-num { font-size: 10px; color: var(--text-secondary); flex-shrink: 0; width: 120px; -unity-text-align: middle-right; }
.stat-value { font-size: 20px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.notice { background-color: var(--bg-raised); border-width: 1px; border-color: var(--border); border-left-width: 3px; border-left-color: var(--success); border-radius: 4px; padding: 8px; margin: 6px 0; white-space: normal; font-size: 11px; }
.notice--warn { border-left-color: var(--warning); }
.hint { font-size: 11px; color: var(--warning); white-space: normal; margin: 4px 0; }
.warn-item { font-size: 11px; color: var(--warning); white-space: normal; margin: 3px 0; }
.budget-bar { height: 6px; border-radius: 3px; background-color: var(--bg-overlay); margin: 4px 0 8px 0; overflow: hidden; }
.budget-fill { height: 6px; background-color: var(--accent); width: 0; }
.budget-fill--over { background-color: var(--danger); }
.cover-row { border-width: 1px; border-color: var(--border); border-radius: 4px; padding: 6px; margin: 4px 0; }
.cover-share { width: 60px; flex-shrink: 0; margin-right: 6px; }

/* list rows (hotspots, suggestions, layer links) */
.layer-list { margin: 4px 0 8px 0; }
.layer-row {
    flex-direction: row; align-items: center; height: 38px; margin: 1px 0; padding: 0 8px;
    border-width: 1px; border-color: var(--border); border-radius: 4px; background-color: var(--bg-raised);
}
.layer-row:hover:enabled { background-color: var(--bg-hover); }
.layer-swatch { width: 10px; height: 10px; border-radius: 2px; margin-right: 8px; flex-shrink: 0; }
.layer-words { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.layer-title { font-size: 12px; -unity-font: resource("UI/Fonts/Inter-Medium"); color: var(--text-primary); margin: 0; padding: 0; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.layer-source { font-size: 10px; color: var(--text-secondary); margin: 0; padding: 0; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.layer-count { font-size: 11px; color: var(--accent); margin-left: 6px; flex-shrink: 0; }
.layer-row--selected { border-color: var(--accent); background-color: var(--accent-soft); }

/* ================= start screen (dark) ================= */
.landing { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--bg-app); overflow: hidden; align-items: center; }
.landing-nav { position: absolute; left: 0; right: 0; top: 0; padding: 24px 64px; align-items: center; }
.brand-mark { width: 28px; height: 28px; border-radius: 6px; background-color: var(--accent); align-items: center; justify-content: center; margin-right: 10px; }
.brand-mark Label { color: var(--accent-ink); font-size: 14px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.landing-brand { color: var(--text-primary); font-size: 18px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.hero { margin-top: 120px; width: 760px; align-items: center; }
.hero-title { color: var(--text-primary); font-size: 40px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); -unity-text-align: middle-center; margin: 0; white-space: normal; }
.hero-accent { color: var(--accent); }
.hero-text { color: var(--text-secondary); font-size: 14px; white-space: normal; -unity-text-align: middle-center; margin: 14px 40px 28px 40px; }
.drop {
    width: 520px; padding: 24px 16px; border-width: 1px; border-color: var(--border-strong);
    background-color: var(--bg-panel); border-radius: 8px; align-items: center;
    transition-property: background-color, border-color; transition-duration: 0.2s;
}
.drop:hover:enabled { background-color: var(--bg-raised); border-color: var(--accent); }
.drop-icon { width: 44px; height: 44px; border-radius: 22px; background-color: var(--accent); align-items: center; justify-content: center; margin-bottom: 10px; }
.drop-icon--clay { background-color: var(--success); }
.drop-arrow { color: var(--accent-ink); font-size: 20px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.drop-title { color: var(--text-primary); font-size: 18px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.drop-text { color: var(--text-secondary); font-size: 12px; margin-top: 2px; white-space: normal; -unity-text-align: middle-center; }
.hero-status { color: var(--warning); font-size: 12px; margin-top: 10px; white-space: normal; -unity-text-align: middle-center; }
.choice-row { justify-content: center; flex-wrap: nowrap; }
.drop--new, .drop--open { width: 300px; margin: 0 8px; padding: 20px 14px; }
.landing-columns { position: absolute; left: 64px; right: 64px; top: 90px; bottom: 40px; flex-direction: row; }
.landing-left { flex-grow: 3; flex-basis: 0; margin-right: 48px; }
.landing-right { flex-grow: 2; flex-basis: 0; min-width: 340px; }
.landing-left .hero { margin-top: 28px; width: auto; align-items: flex-start; padding-bottom: 32px; }
.landing-left .hero-title { -unity-text-align: middle-left; }
.landing-left .hero-text { -unity-text-align: middle-left; margin: 14px 0 26px 0; max-width: 620px; }
.landing-left .choice-row { justify-content: flex-start; align-self: stretch; }
.landing-left .drop--new, .landing-left .drop--open { width: auto; flex-grow: 1; flex-basis: 0; margin: 0 16px 0 0; }
.landing-left .drop--open { margin-right: 0; }
.landing-left .hero-status { -unity-text-align: middle-left; }
.recent { flex-grow: 1; margin-top: 28px; }
.recent-head { justify-content: space-between; align-items: center; flex-wrap: nowrap; margin-bottom: 6px; padding: 0 4px 0 10px; }
.recent-title { color: var(--text-secondary); font-size: 10px; letter-spacing: 2px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.recent-list { background-color: var(--bg-panel); border-width: 1px; border-color: var(--border); border-radius: 8px; padding: 4px; flex-grow: 1; }
.recent-item { flex-direction: row; align-items: center; flex-shrink: 0; }
.recent-open {
    flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; height: 48px; margin: 0; padding: 0 10px 0 8px;
    border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0);
}
.recent-open:hover:enabled { background-color: var(--bg-hover); }
.recent-icon { width: 30px; height: 30px; border-radius: 6px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0; }
.recent-glyph { color: var(--accent); font-size: 12px; }
.recent-words { flex-grow: 1; flex-shrink: 1; overflow: hidden; justify-content: center; }
.recent-name { height: 18px; margin: 0; padding: 0; flex-shrink: 0; color: var(--text-primary); font-size: 13px; -unity-font: resource("UI/Fonts/Inter-Medium"); -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-path { height: 16px; margin: 0; padding: 0; flex-shrink: 0; color: var(--text-secondary); font-size: 11px; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-when { color: var(--text-secondary); font-size: 11px; margin-left: 10px; flex-shrink: 0; -unity-text-align: middle-right; }
.recent-remove { width: 26px; height: 26px; margin: 0 6px 0 2px; padding: 0; border-width: 0; border-radius: 4px; flex-shrink: 0; background-color: rgba(0, 0, 0, 0); color: var(--text-secondary); font-size: 16px; }
.recent-remove:hover:enabled { background-color: rgba(245, 138, 128, 0.25); color: var(--text-primary); }
.recent-item--missing .recent-name, .recent-item--missing .recent-path { color: var(--text-disabled); }
.recent-item--missing .recent-when { color: var(--warning); }
.recent-empty { color: var(--text-secondary); font-size: 12px; -unity-text-align: middle-center; white-space: normal; padding: 18px 14px; }

/* file browser */
.modal-back { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 11, 13, 0.6); align-items: center; justify-content: center; }
.modal { width: 600px; height: 70%; background-color: var(--bg-panel); border-radius: 8px; padding: 18px; border-width: 1px; border-color: var(--border-strong); }
.modal-list { flex-grow: 1; margin: 8px 0; }
.file-item { -unity-text-align: middle-left; height: 30px; border-width: 0; border-radius: 4px; background-color: rgba(0, 0, 0, 0); color: var(--text-primary); padding-left: 10px; margin: 1px 0; font-size: 12px; }
.file-item:hover:enabled { background-color: var(--bg-hover); }
.file-item--file { color: var(--accent); -unity-font: resource("UI/Fonts/Inter-Medium"); }

/* ================= survey intake (full window: plan left, questions right) ================= */
.intake { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--bg-app); }
.plan { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--plan-bg); }
.intake-panel {
    position: absolute; right: 0; top: 0; bottom: 0; width: 460px;
    background-color: var(--bg-panel); border-left-width: 1px; border-color: var(--border-strong);
    transition-property: translate, opacity; transition-duration: 0.2s, 0.2s;
}
.intake-panel--closed { translate: 110% 0; opacity: 0; }
.intake-scroll { flex-grow: 1; padding: 16px 18px; }
.panel-top { justify-content: space-between; }
.plan-caption {
    position: absolute; top: 14px; left: 16px; padding: 6px 12px; border-radius: 6px;
    background-color: rgba(30, 33, 37, 0.92); border-width: 1px; border-color: var(--border);
    color: var(--text-primary); font-size: 12px; -unity-font: resource("UI/Fonts/Inter-Medium");
}
.plan-tools { position: absolute; left: 16px; bottom: 16px; align-items: flex-start; }
.btn.plan-btn {
    width: 34px; height: 34px; min-width: 34px; margin: 6px 0 0 0; padding: 0; border-radius: 6px;
    background-color: var(--bg-raised); border-width: 1px; border-color: var(--border-strong); color: var(--text-primary);
    font-size: 18px; -unity-text-align: middle-center;
}
.btn.plan-btn:hover:enabled { background-color: var(--bg-hover); }
.btn.plan-btn--fit { width: auto; padding: 0 12px; font-size: 12px; -unity-font: resource("UI/Fonts/Inter-Medium"); }
.plan-hint { position: absolute; left: 60px; bottom: 24px; color: var(--text-secondary); font-size: 11px; }
.btn.plan-open { position: absolute; right: 16px; top: 14px; }
.q-card-head { align-items: flex-start; }
.btn.btn--show { height: 24px; padding: 0 10px; font-size: 11px; margin-left: 8px; flex-shrink: 0; }
.page-title { font-size: 22px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); white-space: normal; margin: 2px 0 6px 0; }
.lead { font-size: 12px; color: var(--text-secondary); white-space: normal; margin-bottom: 18px; }
.q-head { justify-content: space-between; align-items: center; margin-top: 4px; }
.badge { background-color: rgba(227, 179, 65, 0.16); color: var(--warning); border-radius: 4px; padding: 3px 8px; font-size: 11px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.q-grid { align-items: flex-start; margin-bottom: 18px; }
.q-card { padding: 12px; margin-bottom: 10px; }
.card--alt { }
.q-card--done { border-color: var(--success); }
.q-image { height: 200px; background-color: var(--plan-bg); border-radius: 6px; border-width: 1px; border-color: var(--border); margin-bottom: 10px; }
.mono { font-size: 13px; -unity-font: resource("UI/Fonts/Inter-SemiBold"); }
.q-ask { font-size: 12px; -unity-font: resource("UI/Fonts/Inter-Medium"); white-space: normal; margin: 8px 0 6px 0; }
.link-list { background-color: var(--bg-raised); border-width: 1px; border-color: var(--border); border-radius: 6px; margin: 8px 0 24px 0; padding: 4px 0; }
.link-row { flex-direction: row; align-items: center; padding: 4px 10px; border-bottom-width: 1px; border-color: var(--border); }
.link-row:hover { background-color: var(--bg-hover); }
.link-dropdown { width: 180px; flex-shrink: 0; }
.figure { flex-grow: 1; max-height: 60%; background-color: var(--plan-bg); border-radius: 6px; border-width: 1px; border-color: var(--border); overflow: hidden; margin-top: 40px; }
.figure-image { flex-grow: 1; }
.caption { -unity-text-align: middle-center; margin: 6px 0 12px 0; }
.textarea .unity-base-text-field__input { min-height: 120px; border-radius: 4px; border-width: 1px; border-color: var(--border-strong); background-color: var(--bg-app); padding: 8px; font-size: 11px; white-space: normal; }
.btn--back { align-self: flex-start; padding-left: 0; }
.card, TextField.input, DropdownField.input, .btn, .chip, .field-label { flex-shrink: 0; }
.figure { flex-shrink: 1; min-height: 180px; }
